{
  "name": "etassia",
  "version": "0.1.1",
  "description": "TypeScript binding for the Etassia Rust runtime (etassia-core compiled to WebAssembly)",
  "license": "BSD-2-Clause",
  "repository": { "type": "git", "url": "git+https://github.com/etassia/etassia-ts.git" },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": { ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" } },
  "files": ["dist"],
  "engines": { "node": ">=20" },
  "scripts": {
    "build:wasm": "node scripts/build-wasm.mjs",
    "build": "npm run build:wasm && tsc -p tsconfig.json",
    "test": "npm run build && node --test test/golden.test.mjs",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}
